{
  "$schema": "http://json.schemastore.org/sarif-2.1.0",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "csc",
          "informationUri": "https://github.com/dotnet/roslyn",
          "rules": [
            { "id": "CA2007", "shortDescription": { "text": "Consider calling ConfigureAwait on the awaited task" } },
            { "id": "CA2000", "shortDescription": { "text": "Dispose objects before losing scope" } },
            { "id": "IDE0051", "shortDescription": { "text": "Remove unused private members" } }
          ]
        }
      },
      "columnKind": "utf16CodeUnits",
      "results": [
        {
          "ruleId": "CA2007",
          "level": "warning",
          "message": { "text": "Consider calling ConfigureAwait on the awaited task." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "Program.cs" },
                "region": { "startLine": 7, "startColumn": 14 }
              }
            }
          ]
        },
        {
          "ruleId": "CA2000",
          "level": "warning",
          "message": { "text": "Call System.IDisposable.Dispose on object created by 'new StringReader(\"governed?\")' before all references to it are out of scope." },
          "suppressions": [ { "kind": "inSource" } ],
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "Program.cs" },
                "region": { "startLine": 13, "startColumn": 18 }
              }
            }
          ]
        },
        {
          "ruleId": "IDE0051",
          "level": "warning",
          "message": { "text": "Private member 'Unused' is unused." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "Program.cs" },
                "region": { "startLine": 10, "startColumn": 15 }
              }
            }
          ]
        }
      ]
    }
  ]
}
