<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# stack binding's inventory tool (Gate 1a, 2026-09-13). Loads a
       solution through MSBuildWorkspace and emits FACTS ONLY as a versioned
       JSON artefact: projects, types, members, declared attributes with
       their arguments, and the reference graph. No rule, no classification,
       no notion of a slice lives here — every judgement is Rust-side in
       product-core (dec/ddd/batch-inventory-reader, constraint 1). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CSharpInventory</RootNamespace>
    <AssemblyName>csharp-inventory</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.11.0" />
  </ItemGroup>

</Project>
